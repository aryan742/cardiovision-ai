 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# CardioVision AI - Exploratory Data Analysis\n",
    "\n",
    "This notebook performs comprehensive exploratory data analysis (EDA) on the Cardiovascular Diseases Risk Prediction Dataset.\n",
    "\n",
    "## Objectives\n",
    "- Understand the distribution of key health metrics\n",
    "- Identify correlations between features and cardiovascular risk\n",
    "- Detect and handle outliers\n",
    "- Prepare insights for the Streamlit dashboard"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set aesthetic style\n",
    "sns.set_theme(style=\"whitegrid\", palette=\"muted\")\n",
    "plt.rcParams['figure.figsize'] = (10, 6)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Load Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "# Attempt to load from the raw data folder\n",
    "data_dir = '../data/raw/'\n",
    "try:\n",
    "    csv_files = [f for f in os.listdir(data_dir) if f.endswith('.csv')]\n",
    "    if csv_files:\n",
    "        df = pd.read_csv(os.path.join(data_dir, csv_files[0]))\n",
    "        print(f\"Loaded dataset: {csv_files[0]}\")\n",
    "        display(df.head())\n",
    "    else:\n",
    "        print(\"No CSV file found in ../data/raw/. Please download the dataset.\")\n",
    "except Exception as e:\n",
    "    print(f\"Error: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Basic Information"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df' in locals():\n",
    "    print(\"Dataset Info:\")\n",
    "    df.info()\n",
    "    \n",
    "    print(\"\\nMissing Values:\")\n",
    "    print(df.isnull().sum())\n",
    "    \n",
    "    print(\"\\nSummary Statistics:\")\n",
    "    display(df.describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Target Variable Distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df' in locals():\n",
    "    # Attempt to find target\n",
    "    possible_targets = ['cardio', 'target', 'risk', 'disease', 'HeartDisease']\n",
    "    target = None\n",
    "    for col in possible_targets:\n",
    "        if col in df.columns:\n",
    "            target = col\n",
    "            break\n",
    "    if not target:\n",
    "        target = df.columns[-1]\n",
    "        \n",
    "    plt.figure(figsize=(8, 5))\n",
    "    sns.countplot(x=target, data=df, palette=\"viridis\")\n",
    "    plt.title(f\"Distribution of Target Variable: {target}\")\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Correlation Heatmap"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df' in locals():\n",
    "    numeric_df = df.select_dtypes(include=[np.number])\n",
    "    plt.figure(figsize=(12, 10))\n",
    "    corr = numeric_df.corr()\n",
    "    \n",
    "    # Generate a mask for the upper triangle\n",
    "    mask = np.triu(np.ones_like(corr, dtype=bool))\n",
    "    \n",
    "    sns.heatmap(corr, mask=mask, annot=True, fmt=\".2f\", cmap=\"coolwarm\", square=True, linewidths=.5)\n",
    "    plt.title(\"Correlation Heatmap of Features\")\n",
    "    plt.show()"
   ]
  }
 ],
